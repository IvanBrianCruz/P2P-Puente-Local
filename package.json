{
  "name": "p2p-local-bridge",
  "version": "2.0.0",
  "description": "Puente P2P para desplegar y compartir proyectos locales en Intranet y Wi-Fi con Panel Admin y QRs",
  "main": "puente.js",
  "bin": "puente.js",
  "scripts": {
    "start": "node puente.js",
    "build:exe": "pkg . --target node18-win-x64 --output P2P-Local-Bridge.exe"
  },
  "keywords": [
    "p2p",
    "bridge",
    "intranet",
    "local-deploy",
    "qr-code",
    "lan-sharing"
  ],
  "author": "Cruz Delgado Ivan - ATLAS Developers",
  "license": "Apache-2.0",
  "pkg": {
    "scripts": [
      "puente.js"
    ],
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
